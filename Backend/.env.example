# =============================================================================
# CineHub Backend — App Settings de referencia
# =============================================================================
# NUNCA subas este archivo con valores reales.
# En Azure App Service, configura cada variable en:
#   Portal Azure > App Service > Configuration > Application settings
# Para producción, referencia Key Vault:
#   @Microsoft.KeyVault(SecretUri=https://kvcinehublabsecrets01.vault.azure.net/secrets/SQL-PASSWORD/)
# =============================================================================

APP_NAME=CineHub Backend
ENVIRONMENT=production
DATA_MODE=sql

# Password temporal compartido para todos los usuarios (tabla Usuario).
# En producción, reemplaza con referencia a Key Vault.
DEMO_PASSWORD=@Microsoft.KeyVault(SecretUri=https://kvcinehublabsecrets01.vault.azure.net/secrets/DEMO-PASSWORD/)

# CORS: orígenes permitidos, separados por coma.
# Si el frontend se sirve desde el mismo App Service (mismo origen), puede dejarse vacío.
# Si usas un dominio privado o App Service separado, agrégalo aquí.
CORS_ORIGINS=https://asp-cinehub-lab-app-01.azurewebsites.net

# ─── Azure SQL Database (Private Endpoint) ───────────────────────────────────
# El FQDN resuelve a 10.20.2.5 via Private DNS Zone: privatelink.database.windows.net
SQL_HOST=sql-cinehub-lab-data-01.database.windows.net
SQL_PORT=1433
SQL_DATABASE=sqldb-cinehub-lab-metadata-01
SQL_USER=cinehubadmin
SQL_PASSWORD=@Microsoft.KeyVault(SecretUri=https://kvcinehublabsecrets01.vault.azure.net/secrets/SQL-PASSWORD/)
# Opciones: "ODBC Driver 18 for SQL Server" o "ODBC Driver 17 for SQL Server"
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUST_SERVER_CERTIFICATE=no

# ─── Azure Blob Storage (Private Endpoint) ───────────────────────────────────
# El FQDN resuelve vía Private DNS Zone: privatelink.blob.core.windows.net
BLOB_ACCOUNT_NAME=stcinehublabmedia01
BLOB_ACCOUNT_URL=https://stcinehublabmedia01.blob.core.windows.net
BLOB_CONTAINER_DEFAULT=materials
BLOB_CONNECTION_STRING=@Microsoft.KeyVault(SecretUri=https://kvcinehublabsecrets01.vault.azure.net/secrets/BLOB-CONNECTION-STRING/)

# ─── Límites de archivos ──────────────────────────────────────────────────────
MAX_UPLOAD_MB=500
